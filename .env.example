# ==============================================================================
# PujaConnect / DevSutra Platform Environment Variables (Template / Example)
# ==============================================================================

# Database Configuration (PostgreSQL 15+ / Neon Cloud)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Backend Configuration (NestJS)
PORT=3001
NODE_ENV=production
API_PREFIX=api/v1
CORS_ORIGINS=https://puja-connect-rho.vercel.app
JWT_SECRET=your_super_secret_jwt_random_key_here
JWT_EXPIRATION=7d

# Frontend Configuration (Next.js)
PORT=3000
NEXT_PUBLIC_API_URL=https://pujaconnect-api-he9b.onrender.com/api/v1
NEXT_PUBLIC_APP_URL=https://puja-connect-rho.vercel.app

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (Gmail SMTP / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="DevSutra <no-reply@devsutra.in>"
